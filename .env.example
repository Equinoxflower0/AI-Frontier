# ============================================================
#  AI Frontier · 环境变量模板
# ============================================================
#  使用方法：
#    1. 复制本文件为 .env        (cp .env.example .env)
#    2. 把下面的占位值换成你自己的真实值
#    3. 确认 .env 已被 .gitignore 排除（本仓库默认已排除）
#
#  ⚠️ 切勿把填好真实值的 .env 提交到 git / 上传到 GitHub。
# ============================================================

# ---------- LLM API Key ----------
# 三个都支持，按优先级自动选择：DOUBAO > OPENAI > DEEPSEEK
#
# 摘要与翻译（score_and_summarize.py）：三者任选其一
# 玩法翻译（score_play.py）与教程生成（generate_tutorials.py）：目前仅支持 DEEPSEEK

# DeepSeek（推荐，国产、成本低）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 豆包 / 火山方舟（可选，仅资讯评分支持）
# DOUBAO_API_KEY=your-doubao-key-here

# OpenAI 及任何兼容 OpenAI 格式的服务（可选，仅资讯评分支持）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 模型选择 ----------
#   deepseek-chat      = DeepSeek-V3（快、便宜，推荐）
#   deepseek-reasoner  = DeepSeek-R1（推理强，慢、贵）
DEEPSEEK_MODEL=deepseek-chat
